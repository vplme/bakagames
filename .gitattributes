# Binary assets are stored in Git LFS. Tracking by extension repo-wide keeps
# the rule simple: any image or sound added anywhere lands in LFS by default.
# Anyone cloning needs git-lfs installed, or these arrive as pointer files.
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text

# SVGs are small hand-editable XML; keeping them as normal blobs preserves
# readable diffs and costs nothing.
*.svg -text diff
